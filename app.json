{
  "expo": {
    "name": "GymBroFitness",
    "slug": "GymBroFitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymbrofitness",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.iordachemihai21.gymbrofitness"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "./plugins/with-mediapipe-pose",
      [
        "expo-notifications",
        {
          "color": "#4D96FF",
          "defaultChannel": "rest-timer-alerts"
        }
      ],
      "react-native-fast-tflite",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "GymBroFitness uses your camera to analyze your exercise form in real time. Video is processed on your device only and never leaves it.",
          "enableFrameProcessors": true,
          "enableCodeScanner": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "GymBroFitness uses your photo library so you can attach a progress photo to a body-tracking entry. Photos stay on this device.",
          "cameraPermission": "GymBroFitness uses your camera so you can take a progress photo directly. Photos stay on this device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
